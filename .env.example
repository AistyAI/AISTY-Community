# Aisty Community. Copy to .env and fill in. Never commit .env.

# The domain people reach this deployment on, without https://. Used for
# invite links, and passkeys are tied to it, so changing it later means
# everyone sets up their passkeys again.
APP_DOMAIN=aisty.example.com

# Postgres, run by docker compose.
POSTGRES_PASSWORD=change-me

# Seals every credential, model key, plan and audit detail before it reaches
# Postgres. Generate with: openssl rand -base64 32
# Losing it makes stored credentials unrecoverable. Back it up separately from
# the database: a backup holding both is a backup with no encryption.
MASTER_KEY=

# Signs sign-in sessions. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
HANKO_SECRET_KEY=

# Email for sign-in codes. Any SMTP service works (Amazon SES, Postmark,
# SendGrid, Microsoft 365, Google Workspace). Port 587 or 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=aisty@example.com

# Lock first-time setup to one email address. Empty: whoever signs in and
# finishes onboarding first becomes the workspace owner.
BOOTSTRAP_OWNER_EMAIL=

# How long a checked sign-in is trusted before asking the sign-in service
# again. Signing out or removing a session takes effect within this time.
SESSION_CACHE_TTL_SECONDS=300

# Agent runtime.
WORKER_CONCURRENCY=3
AGENT_MAX_STEPS=12

# Bind address and port on the host. Keep 127.0.0.1 behind a reverse proxy.
BIND_ADDR=127.0.0.1
PORT=8080

# Image tag to run. Pin a version (e.g. 0.2.0) in production.
AISTY_VERSION=latest
