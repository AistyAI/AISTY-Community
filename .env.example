# Aisty Community. Copy to .env and fill in. Never commit .env.

# The public URL people reach this deployment on. Used in invite links.
APP_URL=https://aisty.example.com

# Postgres, run by docker compose.
POSTGRES_PASSWORD=change-me

# Seals every credential, model key, plan and audit detail before it reaches
# Postgres. Generate with: openssl rand -base64 32
# Losing it makes stored credentials unrecoverable. Back it up separately from
# the database: a backup holding both is a backup with no encryption.
MASTER_KEY=

# Lock first-time setup to one email address. Empty: whoever signs in and
# finishes onboarding first becomes the workspace owner.
BOOTSTRAP_OWNER_EMAIL=

# How long a validated sign-in keeps working without reaching the Aisty
# Identity Service, so a short outage does not interrupt a working team.
SESSION_CACHE_TTL_SECONDS=14400

# Agent runtime.
WORKER_CONCURRENCY=3
AGENT_MAX_STEPS=12

# Bind address and port on the host. Keep 127.0.0.1 behind a reverse proxy.
BIND_ADDR=127.0.0.1
PORT=8080

# Image tag to run. Pin a version (e.g. 0.1.0) in production.
AISTY_VERSION=latest
